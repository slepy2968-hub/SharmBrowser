<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Sharm</AssemblyName>
    <ApplicationIcon>Assets\Sharm.ico</ApplicationIcon>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
  </ItemGroup>
  <ItemGroup><Resource Include="Assets\Glass.ps" /></ItemGroup>
  <ItemGroup><Resource Include="Assets\Fonts\SF*.otf" /></ItemGroup>
  <ItemGroup><RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Assets\Youtube.html" /></ItemGroup>
</Project>
